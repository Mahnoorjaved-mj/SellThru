# Copy this file to .env and fill in real values. Never commit .env.

# ---- Core ----
APP_NAME="Sellthru"
APP_VERSION="1.0.0"
DEBUG=True
LOG_LEVEL=INFO
APP_BASE_URL="http://127.0.0.1:8000"
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# ---- MongoDB ----
# Atlas connection string. Must include credentials; database name is set separately.
MONGO_URI="mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>"
MONGO_DB_NAME="Sellthru"

# ---- JWT authentication ----
# Generate a real secret before running with DEBUG=False, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-me-to-a-random-secret-at-least-32-characters-long"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_HOURS=4

# ---- SMTP / email (optional; OTP/reset emails are skipped if unset) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Sellthru Alerts"
